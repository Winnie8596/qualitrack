<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage collection settings: pass this file to dotnet test with the "XPlat Code Coverage" collector
     (see the api job in .github/workflows/ci.yml). Only hand-written code is measured: source generators'
     output and EF Core migrations are not ours to test. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/*.cs,**/*.g.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
