# Copy to .env and change the passwords. .env is git-ignored; never commit it.
#
# Two ways to run, both reading this file:
#   docker compose up              the whole app at https://localhost:8443 (uses every section but "dotnet run")
#   docker compose up -d db cache  only the services, for `dotnet run` and `npm run dev`

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=qualitrack
POSTGRES_USER=qualitrack
POSTGRES_PASSWORD=change-me
# The port on this machine; inside docker compose the app always reaches the database at db:5432
POSTGRES_PORT=5432

# --- Redis, the dashboard's cache (docker compose) ---
REDIS_PORT=6379

# --- The app container (docker compose) ---
# https://localhost:<APP_PORT>. The browser warns once about the certificate: it comes from the proxy's own
# local authority (see deploy/Caddyfile).
APP_PORT=8443
# Traces and metrics viewer (Aspire Dashboard) at http://localhost:<TELEMETRY_PORT>
TELEMETRY_PORT=18888

# --- Demo users ---
# One per role is created on startup where DemoData:Seed is on: Development, and the app container.
# (inspector@, investigator@, qamanager@qualitrack.demo). Startup fails if any password is missing.
# Identity's rules apply: 6+ characters with upper case, lower case, a digit and a symbol.
DemoUsers__Inspector=Change-me-1
DemoUsers__Investigator=Change-me-1
DemoUsers__QaManager=Change-me-1

# --- dotnet run only ---
# The API reads these from its environment (export them, or use dotnet user-secrets); docker compose sets its
# own for the app container and ignores them. Keep them in step with the POSTGRES_* and REDIS_PORT values above.
ConnectionStrings__QualiTrack=Host=localhost;Port=5432;Database=qualitrack;Username=qualitrack;Password=change-me
# Optional: without it the API caches the dashboard in memory
ConnectionStrings__Redis=localhost:6379
# Optional: where to send traces and metrics (OTLP over gRPC). Unset, none are exported.
# With `docker compose up -d telemetry` running:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
