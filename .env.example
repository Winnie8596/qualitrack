# Copy to .env and change the password. .env is git-ignored; never commit it.
POSTGRES_DB=qualitrack
POSTGRES_USER=qualitrack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# The API reads its connection string from this variable (export it, or use dotnet user-secrets).
# Docker compose ignores it. Keep the values in step with the POSTGRES_* settings above.
ConnectionStrings__QualiTrack=Host=localhost;Port=5432;Database=qualitrack;Username=qualitrack;Password=change-me

# Optional: the dashboard's cache. Without it the API caches in memory. Keep the port in step with REDIS_PORT.
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379

# Development only: the API creates one demo user per role on startup with these passwords
# (inspector@, investigator@, qamanager@qualitrack.demo). Startup fails if any is missing.
# Identity's rules apply: 6+ characters with upper case, lower case, a digit and a symbol.
DemoUsers__Inspector=Change-me-1
DemoUsers__Investigator=Change-me-1
DemoUsers__QaManager=Change-me-1
