# Copy to .env and change the password. .env is git-ignored; never commit it.
POSTGRES_DB=qualitrack
POSTGRES_USER=qualitrack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# The API reads its connection string from this variable (export it, or use dotnet user-secrets).
# Docker compose ignores it. Keep the values in step with the POSTGRES_* settings above.
ConnectionStrings__QualiTrack=Host=localhost;Port=5432;Database=qualitrack;Username=qualitrack;Password=change-me
